# Sender Identity
EMAIL_FROM="Favour - ODI Foundation <favour@odifoundation.org>"
EMAIL_REPLY_TO="favour@odifoundation.org"

# Option 1: SMTP Delivery (e.g. Google Workspace / Gmail / M365 / Zoho)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="favour@odifoundation.org"
# Insert your 16-character Google App Password (or SMTP password) here:
SMTP_PASS=""

# Option 2: Resend API (Alternative to SMTP)
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
